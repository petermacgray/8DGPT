# streamlit_app.py
import streamlit as st
import requests

st.set_page_config(page_title="GPT8D – Analyse de non-conformité", layout="wide")

st.title("🐟 GPT8D – Analyse Ishikawa & 5 Pourquoi")
st.markdown("Analysez vos non-conformités avec l'IA (DeepSeek / autres LLM)")

# Entrée du problème
problem = st.text_area("🛑 Décrire le problème de non-conformité rencontré :", height=150)

# Choix du modèle
model_choice = st.selectbox("📦 Modèle IA utilisé :", ["DeepSeek", "Local (LM Studio / Ollama)"])

# Lancer l’analyse
if st.button("Analyser le problème"):
    with st.spinner("🧠 Génération de l’analyse..."):
        # Appel API (à adapter selon modèle)
        prompt = f"""
        Tu es un expert qualité. À partir du problème suivant : "{problem}", génère :
        1. Un diagramme d'Ishikawa en texte pour identifier les causes potentielles.
        2. Un 5 Pourquoi orienté Occurrence.
        3. Un 5 Pourquoi orienté Détection.
        Formate les réponses pour être facilement copiables dans un rapport 8D.
        """
        
        # Appel de l’API (ex: DeepSeek)
        response = requests.post("https://api.deepseek.com/v1/chat/completions", headers={
            "Authorization": "Bearer VOTRE_CLÉ_API"
        }, json={
            "model": "deepseek-chat",
            "messages": [{"role": "user", "content": prompt}]
        })

        data = response.json()
        result = data["choices"][0]["message"]["content"]
        st.markdown(result)
        st.download_button("📥 Télécharger l’analyse", result, file_name="gpt8d_rapport.md")
